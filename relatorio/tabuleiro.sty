% tabuleiro.sty -- cores do projeto, acesso aos números exportados e desenho de posições do Lig 4.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tabuleiro}[2026/11/01 Lig 4: tabuleiros e numeros do TDE2]
\RequirePackage{tikz}
\RequirePackage{xcolor}

% ---------------- paleta (a mesma do visualizador) ----------------
\definecolor{corX}{HTML}{D7263D}
\definecolor{corO}{HTML}{F2B705}
\definecolor{corTab}{HTML}{1F4E9C}
\definecolor{corTabEsc}{HTML}{163A75}
\definecolor{corFuro}{HTML}{F6F4EF}
\definecolor{corV}{HTML}{1A9E5A}
\definecolor{corE}{HTML}{9AA3AD}
\definecolor{corD}{HTML}{D7263D}
\definecolor{corDestaque}{HTML}{FF7A00}
\definecolor{corAle}{HTML}{6B7078}
\definecolor{corDdois}{HTML}{2B6CB0}
\definecolor{corDquatro}{HTML}{9B2C8F}
\definecolor{corDseis}{HTML}{E07B00}

% ---------------- números gerados por exportar_dados.py ----------------
% \dado{chave}: número formatado em pt-BR; chave inexistente vira ?? em negrito e gera aviso.
\newcommand{\dado}[1]{%
  \ifcsname dado@#1\endcsname\csname dado@#1\endcsname
  \else\textbf{??#1??}\PackageWarning{tabuleiro}{dado '#1' nao definido}\fi}
\InputIfFileExists{dados/numeros.tex}{}{\PackageWarning{tabuleiro}{rode python3 exportar_dados.py}}
\InputIfFileExists{dados/tabuleiros.tex}{}{}
\InputIfFileExists{dados/mapa_janelas.tex}{}{}

% ---------------- tabuleiro ----------------
% \tabuleiro[opções tikz]{linhas}[casas destacadas][coluna com seta]
%   linhas: de cima para baixo, separadas por /, com X, O ou . (ex.: .......//...X...)
%   casas destacadas: lista c/r com r = 0 na linha de baixo (ex.: 2/3,3/2,4/1,5/0)
%   coluna com seta: coluna (0 a 6) marcada com uma seta acima do tabuleiro
\makeatletter
\newcount\tab@r
\newcount\tab@c
\def\tab@fim{\tab@fim}
\def\tab@celula#1{%
  \pgfmathsetmacro\tab@x{\the\tab@c+0.5}%
  \pgfmathsetmacro\tab@y{5.5-\the\tab@r}%
  \if#1X\fill[corX] (\tab@x,\tab@y) circle (0.40);%
  \else\if#1O\fill[corO] (\tab@x,\tab@y) circle (0.40);%
  \else\fill[corFuro] (\tab@x,\tab@y) circle (0.40);\fi\fi}
\def\tab@ler#1{%
  \ifx#1\tab@fim\else
    \if#1/\global\advance\tab@r by 1 \global\tab@c=0
    \else\tab@celula{#1}\global\advance\tab@c by 1 \fi
    \expandafter\tab@ler
  \fi}
\NewDocumentCommand{\tabuleiro}{O{} m O{} O{}}{%
  \begin{tikzpicture}[x=5mm,y=5mm,#1]
    \fill[corTab,rounded corners=1.5pt] (-0.15,-0.15) rectangle (7.15,6.15);
    \global\tab@r=0 \global\tab@c=0
    \edef\tab@s{#2}%
    \expandafter\tab@ler\tab@s\tab@fim
    \if\relax\detokenize{#3}\relax\else
      \edef\tab@hl{#3}%
      \foreach \tc/\tr in \tab@hl {\draw[white,line width=1.2pt] (\tc+0.5,\tr+0.5) circle (0.40);
                                   \fill[white] (\tc+0.5,\tr+0.5) circle (0.10);}%
    \fi
    \if\relax\detokenize{#4}\relax\else
      \fill[corDestaque] (#4+0.5,6.35) -- ++(-0.3,0.45) -- ++(0.6,0) -- cycle;%
    \fi
    \foreach \tc in {0,...,6} \node[font=\tiny,text=black!60] at (\tc+0.5,-0.55) {\tc};
  \end{tikzpicture}}
\makeatother
\endinput
